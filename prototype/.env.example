# Copy to `.env` for `npm run dev` / `npm run build` in this package.
# Vite inlines VITE_* values into the browser bundle, so only public values
# belong here. RAZORPAY_KEY_SECRET must live in the server environment
# (root `.env` or Pages/Vercel secrets) and must never carry a VITE_ prefix.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Clerk publishable key: public by design, required for real sign-in. Without
# it a production build renders signed-out with a configuration notice.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxx
# Optional: absolute API origin when the backend is not same-origin.
# VITE_API_BASE_URL=https://api.example.com

