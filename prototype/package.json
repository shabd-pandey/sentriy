{
  "name": "movie-booking-audience-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:api && tsc -b && npm run check:worker && vite build",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:issuer": "node scripts/dev-issuer.mjs",
    "check:worker": "tsc --noEmit --target ES2022 --lib ES2022,DOM,DOM.Iterable --module ESNext --moduleResolution Bundler --skipLibCheck \"functions/api/[[path]].ts\" \"../backend/src/vercel.ts\"",
    "dev:pages": "wrangler pages dev dist",
    "deploy:pages": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@clerk/clerk-react": "^5.61.10",
    "@neondatabase/serverless": "^1.2.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
