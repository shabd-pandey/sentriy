{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]?__path=$1" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
