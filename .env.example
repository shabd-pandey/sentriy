# Razorpay Standard Checkout — copy to `.env` and fill in real values.
# `.env` is gitignored; this example file is not. Never commit real keys.
#
# Server-side only. Both values are read by the Pages Functions worker
# (backend/src/worker.ts) when it creates orders and verifies signatures.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Shared API (server-side only; set in Cloudflare Pages or Vercel) ----
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUDIENCE=platform-api
# OWNER_EMAILS=you@example.com
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# OBJECT_STORAGE_ENDPOINT=https://...
# OBJECT_STORAGE_REGION=...
# OBJECT_STORAGE_BUCKET=marvelsyllabus-media
# OBJECT_STORAGE_ACCESS_KEY_ID=...
# OBJECT_STORAGE_SECRET_ACCESS_KEY=...

